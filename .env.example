# DataLoom environment template.
# Copy to .env at the repository root. Replace every placeholder.
# Never commit a real .env.

# Public surface
DOMAIN=localhost
ACME_EMAIL=admin@example.com
NEXT_PUBLIC_API_URL=http://localhost:8000/v1

# Datastores
DATABASE_URL=postgresql+asyncpg://dataloom:CHANGE_ME@localhost:5432/dataloom
CHECKPOINT_DATABASE_URL=postgresql://dataloom:CHANGE_ME@localhost:5432/dataloom
REDIS_URL=redis://localhost:6379/0

# Secrets
SECRET_KEY=CHANGE_ME_32_BYTES_MINIMUM_SECRET_KEY_VALUE
INSTALLATION_SECRET_KEY=CHANGE_ME_RANDOM_48_BYTES
INSTALL_ADMIN_EMAILS=[]

# Sessions and cookies
SESSION_COOKIE_NAME=dl_session
CSRF_COOKIE_NAME=dl_csrf
SESSION_TTL_HOURS=168
COOKIE_SECURE=false

# CORS and hosts
CORS_ORIGINS=["http://localhost:3000"]
TRUSTED_HOSTS=["*"]

# Object storage
S3_ENDPOINT_URL=
S3_BUCKET=dataloom-dev
S3_REGION=auto
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_PRESIGN_EXPIRES_SECONDS=900

# Artifact access for the agent worker
ARTIFACT_STORAGE=local
ALLOW_OBJECT_STORAGE=false
ARTIFACT_LOCAL_ROOT=
DUCKDB_PATH=/data/duckdb

# LLM provider (OpenAI-compatible)
LLM_PROVIDER=openai_compatible
LLM_PROVIDER_NAME=openai_compatible
LLM_BASE_URL=https://CHANGE_ME.invalid/v1
LLM_API_KEY=CHANGE_ME_LLM_API_KEY
LLM_MODEL_DEFAULT=CHANGE_ME_MODEL_DEFAULT
LLM_MODEL_SMALL=CHANGE_ME_MODEL_SMALL
LLM_TIMEOUT_SECONDS=60
LLM_PRICE_IN_PER_1K=0.0
LLM_PRICE_OUT_PER_1K=0.0

# Agent execution policy
AGENT_EXECUTION_ENABLED=false
AGENT_MAX_RETRIES=2
AGENT_NODE_TIMEOUT_SECONDS=45
AGENT_RUN_TIMEOUT_SECONDS=300
AGENT_MAX_CONCURRENT_PER_ORG=3
CHECKPOINTER_AUTOSETUP=true
DEFAULT_LLM_BUDGET_USD_MONTH=5.0
DEFAULT_PER_RUN_TOKEN_LIMIT=20000

# Ingest hot path
INGEST_MAX_BODY_BYTES=262144
INGEST_MAX_ROWS=1000
INGEST_MAX_STREAM_LEN=200000
INGEST_BACKPRESSURE_THRESHOLD=150000
INGEST_BATCH_HINT=1000

# Rate limits
RATE_LIMIT_INGEST_PER_SEC=500
RATE_LIMIT_API_PER_MIN=600
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_AGENT_PER_MIN=20

# Uploads
UPLOAD_MAX_BYTES=524288000

# Scheduler
SCHEDULER_ENABLED=false

# Container memory limits
API_MEM_LIMIT=256m
WORKER_MEM_LIMIT=500m
AGENTS_MEM_LIMIT=300m
WEB_MEM_LIMIT=256m